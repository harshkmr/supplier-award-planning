# Valgrind suppressions for CPython runtime internal structures and false positives
# See https://github.com/python/cpython/blob/main/Misc/valgrind-python.supp

{
   ADDRESS_IN_RANGE/InvalidRead
   Memcheck:Addr4
   obj:*/libpython*
}

{
   ADDRESS_IN_RANGE/InvalidRead64
   Memcheck:Addr8
   obj:*/libpython*
}

{
   ADDRESS_IN_RANGE/ConditionalJump
   Memcheck:Cond
   obj:*/libpython*
}

{
   ADDRESS_IN_RANGE/Value8
   Memcheck:Value8
   obj:*/libpython*
}

{
   Python_PyObject_Free
   Memcheck:Addr4
   fun:PyObject_Free
}

{
   Python_PyObject_Free64
   Memcheck:Addr8
   fun:PyObject_Free
}

{
   Python_PyObject_Realloc
   Memcheck:Addr4
   fun:PyObject_Realloc
}

{
   Python_PyObject_Realloc64
   Memcheck:Addr8
   fun:PyObject_Realloc
}

{
   Python_Obmalloc_Pool
   Memcheck:Cond
   fun:PyObject_Malloc
}

{
   Python_Obmalloc_Free
   Memcheck:Cond
   fun:PyObject_Free
}

{
   Python_String_Interning
   Memcheck:Leak
   match-leak-kinds: reachable,possible
   fun:malloc
   ...
   fun:PyUnicode_*
}

{
   Python_Type_Ready
   Memcheck:Leak
   match-leak-kinds: reachable,possible
   fun:malloc
   ...
   fun:PyType_Ready
}

{
   Python_Module_Init
   Memcheck:Leak
   match-leak-kinds: reachable,possible
   fun:malloc
   ...
   fun:PyInit_*
}

{
   Linux_Dynamic_Linker
   Memcheck:Leak
   match-leak-kinds: reachable,possible
   fun:calloc
   fun:_dl_*
}
