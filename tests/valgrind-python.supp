# Valgrind suppressions for CPython runtime internal structures and false positives
# See https://github.com/python/cpython/blob/main/Misc/valgrind-python.supp

{
   glibc_wcscat_avx2
   Memcheck:Addr32
   fun:__wcscat_avx2
}

{
   glibc_wcscat_addr
   Memcheck:Addr*
   ...
   fun:calculate_module_search_path
}

{
   glibc_wcscat_path
   Memcheck:Addr*
   ...
   fun:_PyPathConfig_Calculate
}

{
   glibc_wcscat_exec
   Memcheck:Addr*
   ...
   fun:calculate_exec_prefix
}

{
   CPython_AddressInRange_Read
   Memcheck:Addr4
   ...
   obj:*/libpython*
}

{
   CPython_AddressInRange_Read64
   Memcheck:Addr8
   ...
   obj:*/libpython*
}

{
   CPython_Cond
   Memcheck:Cond
   ...
   obj:*/libpython*
}

{
   CPython_Value8
   Memcheck:Value8
   ...
   obj:*/libpython*
}

{
   CPython_PyObject_Free
   Memcheck:Addr4
   fun:PyObject_Free
}

{
   CPython_PyObject_Free64
   Memcheck:Addr8
   fun:PyObject_Free
}

{
   CPython_PyObject_Realloc
   Memcheck:Addr4
   fun:PyObject_Realloc
}

{
   CPython_PyObject_Realloc64
   Memcheck:Addr8
   fun:PyObject_Realloc
}

{
   CPython_Obmalloc_Pool
   Memcheck:Cond
   fun:PyObject_Malloc
}

{
   CPython_Obmalloc_Free
   Memcheck:Cond
   fun:PyObject_Free
}

{
   CPython_Unicode_Marshal
   Memcheck:Leak
   match-leak-kinds: definite,possible,reachable
   fun:malloc
   ...
   fun:PyUnicode_*
}

{
   CPython_Marshal_Objects
   Memcheck:Leak
   match-leak-kinds: definite,possible,reachable
   fun:malloc
   ...
   fun:r_object
}

{
   CPython_Marshal_Loads
   Memcheck:Leak
   match-leak-kinds: definite,possible,reachable
   fun:malloc
   ...
   fun:marshal_loads*
}

{
   CPython_String_Interning
   Memcheck:Leak
   match-leak-kinds: reachable,possible,definite
   fun:malloc
   ...
   fun:PyUnicode_*
}

{
   CPython_Dict_Resize
   Memcheck:Leak
   match-leak-kinds: reachable,possible,definite
   fun:malloc
   ...
   fun:dictresize
}

{
   CPython_Type_Ready
   Memcheck:Leak
   match-leak-kinds: reachable,possible,definite
   fun:malloc
   ...
   fun:PyType_Ready
}

{
   CPython_Module_Init
   Memcheck:Leak
   match-leak-kinds: reachable,possible,definite
   fun:malloc
   ...
   fun:PyInit_*
}

{
   Linux_Dynamic_Linker
   Memcheck:Leak
   match-leak-kinds: reachable,possible,definite
   fun:calloc
   fun:_dl_*
}

{
   Linux_Dynamic_Linker_Malloc
   Memcheck:Leak
   match-leak-kinds: reachable,possible,definite
   fun:malloc
   fun:_dl_*
}
