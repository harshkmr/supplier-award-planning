# Valgrind suppressions for CPython runtime internal structures and false positives

{
   glibc_wcscat_avx2_addr32
   Memcheck:Addr32
   fun:__wcscat_avx2
}

{
   glibc_wcscat_avx2_addr8
   Memcheck:Addr8
   fun:__wcscat_avx2
}

{
   glibc_wcscat_avx2_addr4
   Memcheck:Addr4
   fun:__wcscat_avx2
}

{
   glibc_wcscat_avx2_cond
   Memcheck:Cond
   fun:__wcscat_avx2
}

{
   glibc_wcscat_avx2_value8
   Memcheck:Value8
   fun:__wcscat_avx2
}

{
   CPython_Path_Calculate_Addr32
   Memcheck:Addr32
   ...
   fun:_PyPathConfig_Calculate
}

{
   CPython_Path_Calculate_Addr8
   Memcheck:Addr8
   ...
   fun:_PyPathConfig_Calculate
}

{
   CPython_Path_Calculate_Cond
   Memcheck:Cond
   ...
   fun:_PyPathConfig_Calculate
}

{
   CPython_Path_Calculate_Value8
   Memcheck:Value8
   ...
   fun:_PyPathConfig_Calculate
}

{
   CPython_AddressInRange_Read
   Memcheck:Addr4
   ...
   obj:*/libpython*
}

{
   CPython_AddressInRange_Read64
   Memcheck:Addr8
   ...
   obj:*/libpython*
}

{
   CPython_AddressInRange_Read32
   Memcheck:Addr32
   ...
   obj:*/libpython*
}

{
   CPython_Cond
   Memcheck:Cond
   ...
   obj:*/libpython*
}

{
   CPython_Value8
   Memcheck:Value8
   ...
   obj:*/libpython*
}

{
   CPython_PyObject_Free
   Memcheck:Addr4
   fun:PyObject_Free
}

{
   CPython_PyObject_Free64
   Memcheck:Addr8
   fun:PyObject_Free
}

{
   CPython_PyObject_Realloc
   Memcheck:Addr4
   fun:PyObject_Realloc
}

{
   CPython_PyObject_Realloc64
   Memcheck:Addr8
   fun:PyObject_Realloc
}

{
   CPython_Obmalloc_Pool
   Memcheck:Cond
   fun:PyObject_Malloc
}

{
   CPython_Obmalloc_Free
   Memcheck:Cond
   fun:PyObject_Free
}

{
   CPython_Unicode_Marshal
   Memcheck:Leak
   match-leak-kinds: definite,possible,reachable
   fun:malloc
   ...
   fun:PyUnicode_*
}

{
   CPython_Marshal_Objects
   Memcheck:Leak
   match-leak-kinds: definite,possible,reachable
   fun:malloc
   ...
   fun:r_object
}

{
   CPython_Marshal_Loads
   Memcheck:Leak
   match-leak-kinds: definite,possible,reachable
   fun:malloc
   ...
   fun:marshal_loads*
}

{
   CPython_String_Interning
   Memcheck:Leak
   match-leak-kinds: reachable,possible,definite
   fun:malloc
   ...
   fun:PyUnicode_*
}

{
   CPython_Dict_Resize
   Memcheck:Leak
   match-leak-kinds: reachable,possible,definite
   fun:malloc
   ...
   fun:dictresize
}

{
   CPython_Type_Ready
   Memcheck:Leak
   match-leak-kinds: reachable,possible,definite
   fun:malloc
   ...
   fun:PyType_Ready
}

{
   CPython_Module_Init
   Memcheck:Leak
   match-leak-kinds: reachable,possible,definite
   fun:malloc
   ...
   fun:PyInit_*
}

{
   Linux_Dynamic_Linker
   Memcheck:Leak
   match-leak-kinds: reachable,possible,definite
   fun:calloc
   fun:_dl_*
}

{
   Linux_Dynamic_Linker_Malloc
   Memcheck:Leak
   match-leak-kinds: reachable,possible,definite
   fun:malloc
   fun:_dl_*
}
