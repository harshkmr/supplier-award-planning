# Valgrind suppressions for CPython runtime internal structures and false positives
# See https://github.com/python/cpython/blob/main/Misc/valgrind-python.supp

{
   CPython_AddressInRange_Read
   Memcheck:Addr4
   ...
   obj:*/libpython*
}

{
   CPython_AddressInRange_Read64
   Memcheck:Addr8
   ...
   obj:*/libpython*
}

{
   CPython_Cond
   Memcheck:Cond
   ...
   obj:*/libpython*
}

{
   CPython_Value8
   Memcheck:Value8
   ...
   obj:*/libpython*
}

{
   CPython_PyObject_Free
   Memcheck:Addr4
   fun:PyObject_Free
}

{
   CPython_PyObject_Free64
   Memcheck:Addr8
   fun:PyObject_Free
}

{
   CPython_PyObject_Realloc
   Memcheck:Addr4
   fun:PyObject_Realloc
}

{
   CPython_PyObject_Realloc64
   Memcheck:Addr8
   fun:PyObject_Realloc
}

{
   CPython_Obmalloc_Pool
   Memcheck:Cond
   fun:PyObject_Malloc
}

{
   CPython_Obmalloc_Free
   Memcheck:Cond
   fun:PyObject_Free
}

{
   CPython_String_Interning
   Memcheck:Leak
   match-leak-kinds: reachable,possible
   fun:malloc
   ...
   fun:PyUnicode_*
}

{
   CPython_Dict_Resize
   Memcheck:Leak
   match-leak-kinds: reachable,possible
   fun:malloc
   ...
   fun:dictresize
}

{
   CPython_Type_Ready
   Memcheck:Leak
   match-leak-kinds: reachable,possible
   fun:malloc
   ...
   fun:PyType_Ready
}

{
   CPython_Module_Init
   Memcheck:Leak
   match-leak-kinds: reachable,possible
   fun:malloc
   ...
   fun:PyInit_*
}

{
   Linux_Dynamic_Linker
   Memcheck:Leak
   match-leak-kinds: reachable,possible
   fun:calloc
   fun:_dl_*
}

{
   Linux_Dynamic_Linker_Malloc
   Memcheck:Leak
   match-leak-kinds: reachable,possible
   fun:malloc
   fun:_dl_*
}
